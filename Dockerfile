FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build`nWORKDIR /src`nCOPY ["backend/StudentHub.API/StudentHub.API.csproj", "backend/StudentHub.API/"]`nRUN dotnet restore "backend/StudentHub.API/StudentHub.API.csproj"`nCOPY . .`nWORKDIR "/src/backend/StudentHub.API"`nRUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false`n`nFROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final`nWORKDIR /app`nCOPY --from=build /app/publish .`nENTRYPOINT ["dotnet", "StudentHub.API.dll"]
